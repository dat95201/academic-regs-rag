# LLM_PROVIDER=ollama (local LLM_MODEL) | openai (cloud OPENAI_MODEL). ./start.sh --cloud sets openai.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OPENAI_MODEL=gpt-4o-mini
# Better: export OPENAI_API_KEY in the shell when starting instead of storing it here.
# OPENAI_API_KEY=sk-...
EMBED_MODEL=bge-m3
OLLAMA_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=quy_che
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
TOP_K_RETRIEVE=20
TOP_K_FINAL=5
HYBRID_SEARCH=true
# Weights of the two branches when the results are fused.
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=0.8
# Rerank the candidates before the model sees them.
#   heuristic = free and local (term coverage + title match + article match + diversity)
#   llm       = one extra call to the chat model, better on vague questions, slower
#   off       = keep the fusion order
RERANK_ENABLED=true
RERANK_MODE=heuristic
RERANK_CANDIDATES=20
# Nothing below this cosine counts as an answer.
MIN_RELEVANCE_SCORE=0.3
# Giữ một chunk chỉ khi điểm của nó còn trong khoảng này so với chunk tốt nhất.
# Hạ xuống (0.8) = nhiều nguồn hơn, nâng lên (0.9) = chỉ giữ nguồn sát đề.
RELATIVE_CUTOFF=0.85
# "GPA", "rớt môn", "hoc phan" -> the wording the regulation uses (app/rag/glossary.py).
GLOSSARY_EXPANSION=true
# "Điều 15 nói gì?" -> fetch Điều 15 directly instead of hoping the vectors agree.
ARTICLE_LOOKUP=true
# Add the neighbouring chunks of a kept article (15.3 is often answered by 15.4).
CONTEXT_EXPANSION=true
CONTEXT_NEIGHBOURS=2
# Skip the rewrite round trip when a follow-up already stands on its own.
REWRITE_FOLLOW_UPS=true
LLM_TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=4000

# Questions and latency, one JSON line each -> GET /metrics. Nothing leaves the machine.
LOG_QUERIES=true
# LOG_DIR=data/logs
# QUERY_CACHE_SIZE=256

# --- infrastructure (optional) ---
# APP_PORT=8080
# OLLAMA_IMAGE=ollama/ollama:0.11.4
# QDRANT_IMAGE=qdrant/qdrant:v1.15.1
# EMBED_BATCH_SIZE=16
